root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs}]
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

# C# code-style rules and analyzer severities to be expanded per the
# quality-gate convention in CLAUDE.md (treat warnings as errors where reasonable).
