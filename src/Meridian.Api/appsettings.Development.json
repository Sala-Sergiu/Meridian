{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Dev override: the locally installed SQL Server (Windows auth, shared
    // memory — no TCP needed). The base appsettings.json string targets the
    // docker-compose MSSQL (localhost,1433 / sa) used outside local dev.
    "Default": "Server=localhost;Database=Meridian;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False"
  }
}
